OPENAI_API_KEY=
ARCHITEKT_OPENAI_MODEL=gpt-6-luna
ARCHITEKT_OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
ARCHITEKT_OPENAI_REVIEW_MODEL=gpt-6-sol

# Paid-AI access and admission. Leave blank until managed Redis and secrets are configured.
# Use a separate Redis database or namespace for preview and production; VERCEL_ENV is
# also included in every key prefix. Never use NEXT_PUBLIC_ for these values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate two independent 32-byte random hex values in a secure operator environment.
ARCHITEKT_PAID_AI_CREDENTIAL_SECRET=
ARCHITEKT_PAID_AI_IP_SECRET=
ARCHITEKT_PAID_AI_NAMESPACE=architekt
# Comma-separated exact public origins. Production must use HTTPS. Explicitly list
# localhost and 127.0.0.1 separately when needed in local development.
# Preview requires its own exact HTTPS origin and Redis configuration.
ARCHITEKT_PAID_AI_ALLOWED_ORIGINS=
# Optional strict JSON object overriding numeric policy defaults; blank uses documented defaults.
ARCHITEKT_PAID_AI_POLICY_JSON=
# Local-only explicit IP bucket for testing; never used on Vercel.
ARCHITEKT_PAID_AI_LOCAL_CLIENT_IP=
